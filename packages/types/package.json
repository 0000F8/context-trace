{
  "name": "@context-trace/types",
  "version": "0.1.0",
  "description": "Shared wire types, compiled-trace types, and utilities (fnv1a64, estimateTokens, generateId) for context-trace. Dependency-free and runtime-agnostic.",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/0000F8/context-trace.git",
    "directory": "packages/types"
  },
  "homepage": "https://github.com/0000F8/context-trace/tree/main/packages/types#readme",
  "bugs": "https://github.com/0000F8/context-trace/issues",
  "keywords": [
    "llm",
    "observability",
    "tracing",
    "context-engineering",
    "types"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
