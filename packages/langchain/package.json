{
  "name": "@context-trace/langchain",
  "version": "0.1.0",
  "description": "LangChain-compatible callback handler that captures LLM context assemblies into context-trace. Structural typing only — no dependency on langchain itself.",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/0000F8/context-trace.git",
    "directory": "packages/langchain"
  },
  "homepage": "https://github.com/0000F8/context-trace/tree/main/packages/langchain#readme",
  "bugs": "https://github.com/0000F8/context-trace/issues",
  "keywords": [
    "llm",
    "observability",
    "tracing",
    "context-engineering",
    "langchain",
    "callback-handler"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@context-trace/sdk": "0.1.0",
    "@context-trace/types": "0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
